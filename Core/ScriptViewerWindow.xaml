<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script viewer" Width="1060" Height="780" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Tk.WindowBackground}" Foreground="{DynamicResource Tk.Text}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="ReadOnlyBadge" DockPanel.Dock="Right" Text="Read-only view - nothing here runs the script"
                               Foreground="{DynamicResource Tk.SubtleText}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ViewerTitle" FontSize="17" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBox x:Name="ViewerPath" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Tk.Text}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock x:Name="ViewerMeta" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                <TextBox x:Name="ViewerHash" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Tk.SubtleText}" FontFamily="Consolas" FontSize="11" ToolTip="SHA-256 of the file - compare it to confirm which version you reviewed"/>
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CopyAllButton" Content="Copy all" Padding="10,3"/>
                        <Button x:Name="OpenEditorButton" Content="Open in Notepad" Padding="10,3"
                                ToolTip="Open the file in Notepad (for searching or printing). Edits there change the module."/>
                        <Button x:Name="RefreshViewerButton" Content="Refresh" Padding="10,3"/>
                    </StackPanel>
                    <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="FindBox" Width="240" Padding="4,2" ToolTip="Highlights matching lines. Enter = next match, Shift+Enter = previous"/>
                    <Button x:Name="FindNextButton" Content="Next" Padding="10,2"/>
                    <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Tk.SubtleText}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="4">
            <TabControl x:Name="ViewerTabs" BorderThickness="0">
                <TabItem x:Name="ScriptTab" Header="Script">
                    <ListBox x:Name="CodeList" FontFamily="Consolas" FontSize="12.5" BorderThickness="0"
                             SelectionMode="Extended" HorizontalContentAlignment="Left"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </TabItem>
                <TabItem x:Name="ManifestTab" Header="module.json">
                    <ListBox x:Name="ManifestList" FontFamily="Consolas" FontSize="12.5" BorderThickness="0"
                             SelectionMode="Extended" HorizontalContentAlignment="Left"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
