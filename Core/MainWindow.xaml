<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Toolkit" Height="800" Width="1260" MinHeight="580" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Tk.WindowBackground}" Foreground="{DynamicResource Tk.Text}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- Styles live in Styles.xaml (application resources). -->
    <DockPanel>
        <!-- Header: title + connection state -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Tk.HeaderBackground}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GraphDot" Width="10" Height="10" Fill="{DynamicResource Tk.Disconnected}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GraphStatus" Text="Graph: not connected" Foreground="{DynamicResource Tk.HeaderStatusText}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <Ellipse x:Name="ExoDot" Width="10" Height="10" Fill="{DynamicResource Tk.Disconnected}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ExoStatus" Text="Exchange: not connected" Foreground="{DynamicResource Tk.HeaderStatusText}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <Button x:Name="ConnectGraphButton" Content="Connect Graph"/>
                    <Button x:Name="ConnectExoButton" Content="Connect Exchange"/>
                    <Button x:Name="DisconnectButton" Content="Disconnect all"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Admin Toolkit" Foreground="{DynamicResource Tk.HeaderText}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource Tk.HeaderSubtle}" FontSize="12" Margin="8,0,0,2" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock x:Name="SubTitle" Text="Modular PowerShell tasks" Foreground="{DynamicResource Tk.HeaderSubtle}" FontSize="11"/>
                </StackPanel>
                <!-- The tenant every run goes to: name and ID, read from the signed-in session -->
                <Border x:Name="TenantBox" Margin="28,0,18,0" Padding="10,2,0,2" BorderThickness="3,0,0,0" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Tk.Disconnected}" AutomationProperties.Name="Current tenant">
                    <StackPanel>
                        <TextBlock x:Name="TenantName" Text="No tenant - not signed in" Foreground="{DynamicResource Tk.HeaderText}"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TenantIdText" Text="Tenant ID: -" Foreground="{DynamicResource Tk.HeaderSubtle}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Margin="0,0,6,0">
                <ProgressBar x:Name="BusyBar" Width="140" Height="10" Visibility="Collapsed"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Top-level pages. Modules (the first tab) is where you work; Settings holds toolkit housekeeping. -->
        <TabControl x:Name="MainTabs" BorderThickness="0" Margin="10,6,10,10" Padding="0">
        <TabItem x:Name="ModulesTab" AutomationProperties.Name="Modules">
            <TabItem.Header>
                <TextBlock Text="Modules" FontSize="14" FontWeight="SemiBold"/>
            </TabItem.Header>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Module browser -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="AddModuleButton" DockPanel.Dock="Right" Content="+ Add module" Margin="0" Padding="10,3"
                                ToolTip="Turn an existing script (.ps1, .cmd, .bat, .sh, .zsh, .py) into a module, or start from a blank template"/>
                        <TextBlock Text="Modules" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="0,0,0,8" Padding="4,3"
                             ToolTip="Search by name, category, tag or description"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Group by" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Tk.SubtleText}"/>
                        <ComboBox x:Name="GroupByBox">
                            <ComboBoxItem Content="Category" Tag="Category"/>
                            <ComboBoxItem Content="Tag" Tag="Tag"/>
                            <ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
                            <ComboBoxItem Content="Language" Tag="Runtime"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Filter by tag" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                        <WrapPanel x:Name="TagPanel"/>
                    </ScrollViewer>
                    <Button DockPanel.Dock="Bottom" x:Name="ReloadButton" Content="Reload modules" Margin="0,8,0,0"/>
                    <TreeView x:Name="ModuleTree" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Tk.CardBorder}" Padding="0,6,0,0"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*" MinHeight="160"/>
                </Grid.RowDefinitions>

                <!-- Selected module header -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <DockPanel>
                        <!-- Module actions on the right; Run / Cancel under them, beside the title and description. -->
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="ViewScriptButton" Content="View script" Padding="8,2" Margin="6,0,0,0" Cursor="Hand"
                                              Visibility="Collapsed" ToolTip="Show the module's whole script (read-only). The viewer follows your selection."/>
                                <Button x:Name="EditTagsButton" Content="Edit tags" Padding="8,2" Visibility="Collapsed"/>
                                <Button x:Name="OpenFolderButton" Content="Open folder" Padding="8,2" Visibility="Collapsed"
                                        ToolTip="Open the module's folder to edit module.json or module.ps1"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="RunButton" Content="Run" MinWidth="90" IsEnabled="False" Style="{StaticResource Primary}"/>
                                <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="FavoriteButton" Style="{StaticResource StarButton}" FontSize="22" Content="&#x2606;"
                                        Visibility="Collapsed" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ModuleTitle" Text="Select a module" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="ModuleMeta" Foreground="{DynamicResource Tk.SubtleText}" FontSize="11" Margin="0,2,0,6"/>
                            <WrapPanel x:Name="HeaderTagPanel"/>
                            <DockPanel x:Name="TagEditPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                <Button x:Name="CancelTagsButton" DockPanel.Dock="Right" Content="Cancel" Padding="8,2"/>
                                <Button x:Name="SaveTagsButton" DockPanel.Dock="Right" Content="Save tags" Padding="8,2" Style="{StaticResource Primary}"/>
                                <TextBox x:Name="TagEditBox" Padding="4,2"/>
                            </DockPanel>
                            <TextBlock x:Name="ModuleDescription" TextWrapping="Wrap"
                                       Text="Pick a task from the list on the left. Its inputs appear below. Click a star to make it a favourite."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Width set in code: * while the selected module has a readiness figure, otherwise 0. -->
                        <ColumnDefinition x:Name="ReadinessColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Generated parameter form -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <CheckBox x:Name="WhatIfCheck" Visibility="Collapsed" FontWeight="SemiBold"
                                          Content="Dry run (WhatIf) - nothing is changed in Microsoft 365"/>
                                <TextBlock x:Name="DryRunInfo" Style="{StaticResource Hint}" Margin="20,2,8,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ParamPanel" Margin="0,0,8,0"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Tenant readiness from the selected module's last run (Write-TkReadiness) -->
                    <Border x:Name="ReadinessCard" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Tenant readiness" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="ReadinessGauge" Grid.Column="0" Width="150" Height="150" VerticalAlignment="Top" Margin="4,0,20,0">
                                    <Ellipse Stroke="{DynamicResource Tk.ReadinessTrack}" StrokeThickness="14"/>
                                    <!-- Arc length comes from StrokeDashArray; rotated so it starts at 12 o'clock. -->
                                    <Ellipse x:Name="ReadinessRing" StrokeThickness="14" StrokeDashCap="Flat" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ReadinessBig" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ReadinessSmall" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="ReadinessLabel" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ReadinessNotEvaluated" Foreground="{DynamicResource Tk.Warning}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ReadinessThresholds" Foreground="{DynamicResource Tk.SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <!-- Off: percentage large in the ring. On: Pass / Warn / Fail large. -->
                                    <ToggleButton x:Name="ReadinessViewButton" Style="{StaticResource Switch}" Tag="Percentage" Content="Pass / Warn / Fail"
                                                  Margin="0,12,0,0" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Show readiness as Pass, Warn or Fail instead of a percentage"
                                                  ToolTip="Choose what the ring shows in large type"/>
                                    <TextBlock x:Name="ReadinessSource" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent"/>

                <!-- Results and log -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
                    <TabControl x:Name="OutputTabs" BorderThickness="0">
                        <TabItem x:Name="ResultsTab" Header="Results">
                            <DockPanel Margin="0,6,0,0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                    <TextBlock x:Name="ResultCount" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Tk.SubtleText}" Text="No results yet"/>
                                    <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Export CSV..." IsEnabled="False"/>
                                    <Button x:Name="OpenExcelButton" DockPanel.Dock="Right" Content="Open in Excel" IsEnabled="False"
                                            ToolTip="Open the results as a table in a new, unsaved Excel workbook. Nothing is written to disk until you save it."/>
                                </DockPanel>
                                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="{DynamicResource Tk.RowAlternate}"
                                          ClipboardCopyMode="IncludeHeader" SelectionMode="Extended"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="BlockedTab" Header="Blocked changes">
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock x:Name="BlockedSummary" DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="{DynamicResource Tk.SubtleText}" TextWrapping="Wrap"
                                           Text="Changes the dry-run guard stopped appear here: each is something the script tried to do in Microsoft 365."/>
                                <DataGrid x:Name="BlockedGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="{DynamicResource Tk.RowBlockedAlternate}"
                                          ClipboardCopyMode="IncludeHeader" SelectionMode="Extended"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="LogTab" Header="Log">
                            <DockPanel Margin="0,6,0,0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Tk.SubtleText}"
                                               Text="Everything shown since the toolkit started"/>
                                    <Button x:Name="ExportLogButton" DockPanel.Dock="Right" Content="Export log..."
                                            ToolTip="Save this log as a text file. It includes everything shown here, which can include user and mailbox names - store and share it accordingly."/>
                                </DockPanel>
                                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         BorderThickness="0"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
        </TabItem>

        <TabItem x:Name="SettingsTab" AutomationProperties.Name="Settings">
            <TabItem.Header>
                <TextBlock x:Name="SettingsTabHeader" Text="Settings" FontSize="14" FontWeight="SemiBold"/>
            </TabItem.Header>
            <DockPanel x:Name="SettingsPage" Margin="0,8,0,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!-- Personal: saved in %APPDATA% preferences -->
                <Border x:Name="AppearanceSection" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ThemeBox" MinWidth="150" Padding="6,1,24,1" AutomationProperties.Name="Theme"
                                      ToolTip="Match Windows follows the light/dark app mode in Windows Settings">
                                <ComboBoxItem Content="Match Windows" Tag="System"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Saved for you only, on this PC."/>
                    </StackPanel>
                </Border>
                <!-- Toolkit policy: saved in Config\settings.json, read by the worker's session check -->
                <Border x:Name="SessionSection" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sign-in sessions" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Sign out" Width="70" VerticalAlignment="Center"/>
                            <TextBox x:Name="MaxAgeHoursBox" Width="56" Padding="4,2" TextAlignment="Right"
                                     AutomationProperties.Name="Sign out after this many hours since sign-in (1 to 24)"/>
                            <TextBlock Text="hours after sign-in (1-24)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sign out" Width="70" VerticalAlignment="Center"/>
                            <TextBox x:Name="IdleMinutesBox" Width="56" Padding="4,2" TextAlignment="Right"
                                     AutomationProperties.Name="Sign out after this many minutes without use (1 to 1440)"/>
                            <TextBlock Text="minutes without use (1-1440)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Button x:Name="SaveSessionButton" Content="Save" Style="{StaticResource Primary}" Margin="16,0,0,0" Padding="14,2"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionSettingsInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Sessions also always end at midnight, when the PC sleeps and when the toolkit closes. Saved in Config\settings.json for everyone using this copy of the toolkit, and applied at once."/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="InventorySection" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Installed PowerShell modules" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="The Microsoft 365 PowerShell modules on this PC that the toolkit and its modules use."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                        <Button x:Name="UpdateModulesButton" DockPanel.Dock="Right" Content="Update all" IsEnabled="False"
                                Style="{StaticResource Primary}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Click 'Check for updates' first"/>
                        <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Content="Check for updates"
                                ToolTip="Compare installed versions with the latest on the PowerShell Gallery (needs internet)"/>
                        <Button x:Name="RescanModulesButton" DockPanel.Dock="Right" Content="Rescan"
                                ToolTip="List the PowerShell modules installed on this PC again"/>
                        <Button x:Name="UninstallModulesButton" DockPanel.Dock="Right" Content="Uninstall" IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True" ToolTip="Select the installed modules to remove first"/>
                        <Button x:Name="ModuleFoldersButton" DockPanel.Dock="Right" Content="Module folders"
                                ToolTip="Show where PowerShell modules are installed on this PC, and open the folder"/>
                        <CheckBox x:Name="ShowGraphSubCheck" DockPanel.Dock="Right" Content="Show Graph sub-modules"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="InventorySummary" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Tk.SubtleText}"
                                   TextWrapping="Wrap" Text="Scanning installed PowerShell modules..."/>
                    </DockPanel>
                    <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="True" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              ClipboardCopyMode="IncludeHeader" SelectionMode="Extended">
                        <!-- Rows that need attention are tinted: red = missing, amber = should be fixed. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Missing">
                                        <Setter Property="Background" Value="{DynamicResource Tk.RowMissing}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Update available">
                                        <Setter Property="Background" Value="{DynamicResource Tk.RowWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Version mismatch">
                                        <Setter Property="Background" Value="{DynamicResource Tk.RowWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Retired">
                                        <Setter Property="Background" Value="{DynamicResource Tk.RowWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Not installed">
                                        <Setter Property="Foreground" Value="{DynamicResource Tk.FaintText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>
            </DockPanel>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
